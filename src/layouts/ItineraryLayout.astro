---
import '~/styles/itinerary.css';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAbsolute?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage, ogImageAbsolute, jsonLd } = Astro.props;
---
<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAbsolute={ogImageAbsolute}
  jsonLd={jsonLd}
  type="article"
  header={false}
  mainClass="itinerary-main"
>
  <slot />
</BaseLayout>

{/* Sticky chapter rail scroll-spy. Bound to astro:page-load for View Transitions. */}
<script>
  function initSidenavSpy() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.sidenav a[href^="#"]'),
    );
    if (!links.length) return;

    const sections = new Map<Element, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.getAttribute('href')!.slice(1);
      const section = document.getElementById(id);
      if (section) sections.set(section, link);
    }
    if (!sections.size) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            for (const link of links) link.classList.remove('is-active');
            sections.get(entry.target)?.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 },
    );

    for (const section of sections.keys()) observer.observe(section);
  }

  document.addEventListener('astro:page-load', initSidenavSpy);
</script>
