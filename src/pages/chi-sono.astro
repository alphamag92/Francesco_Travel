---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/paths';
import { AUTHOR } from '~/data/site';
import fra from '~/assets/FRA.jpg';

// Bio text taken VERBATIM from the original chi_sono.html (the page is the
// source of truth for the real wording; it differs from AUTHOR.bio).
const bio = [
  "Fin da piccolo, i racconti di terre lontane e culture diverse hanno acceso in me una curiosità insaziabile. Questa curiosità si è trasformata in una profonda passione per i viaggi, ma non solo per l'atto di spostarsi: amo immergermi nella fase di ricerca, studiare le destinazioni e, soprattutto, adoro la sfida e la creatività della progettazione di ogni singolo itinerario. Per me, ogni viaggio inizia molto prima della partenza, con la mappa aperta e la mente che già esplora sentieri e città. Spero, attraverso questo blog, di condividere non solo le mie esperienze, ma anche l'entusiasmo e la cura che metto nel pianificare ogni avventura, sperando di ispirarvi!",
];
---

<BaseLayout title="Chi sono" description={bio[0]}>
  <section class="page chi">
    <header class="chi__head">
      <p class="eyebrow">Chi sono</p>
      <h1 class="chi__title serif">{AUTHOR.name}</h1>
      <p class="chi__role mono">{AUTHOR.role}</p>
    </header>

    <div class="chi__grid">
      <figure class="chi__figure">
        <div class="media ar-4-5">
          <Image
            src={fra}
            alt={`Ritratto di ${AUTHOR.name}`}
            widths={[400, 600, 800]}
            sizes="(max-width: 720px) 92vw, 420px"
            loading="eager"
          />
        </div>
      </figure>

      <div class="chi__text">
        {bio.map((p) => <p class="chi__p">{p}</p>)}

        <div class="chi__cta">
          <a class="btn" href={withBase('itinerari')}>Esplora gli itinerari</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .chi {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }
  .chi__head {
    max-width: 56ch;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .chi__title {
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 16px 0 14px;
  }
  .chi__role {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .chi__grid {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .chi__figure {
    margin: 0;
  }
  .chi__figure .media {
    border-radius: 4px;
    border: 1px solid var(--rule);
  }
  .chi__text {
    max-width: 60ch;
  }
  .chi__p {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .chi__p + .chi__p {
    margin-top: 1.1em;
  }
  .chi__cta {
    margin-top: clamp(28px, 4vw, 44px);
  }

  /* collapse to single column on narrow viewports */
  @media (max-width: 720px) {
    .chi__grid {
      grid-template-columns: 1fr;
    }
    .chi__figure .media {
      max-width: 340px;
    }
  }
</style>
