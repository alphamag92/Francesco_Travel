---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FlightDashboard from '~/components/react/FlightDashboard';
import data from '~/data/analisi/italia-cina';
import { withBase } from '~/lib/paths';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: data.title,
  description: data.intro,
};
---

<BaseLayout title={data.title} description={data.intro} jsonLd={jsonLd}>
  <section class="page analisi-detail">
    <header class="analisi-detail__head">
      <a class="back-link" href={withBase('analisi')}>← Analisi</a>
      <p class="eyebrow">Analisi</p>
      <h1 class="analisi-detail__title">{data.title}</h1>
      <p class="analisi-detail__intro">{data.intro}</p>
      {data.updated && <p class="analisi-detail__updated">Aggiornato: {data.updated}</p>}
    </header>

    <FlightDashboard client:visible data={data} />
  </section>
</BaseLayout>

<style>
  .analisi-detail {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }
  .analisi-detail__head {
    max-width: 64ch;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .back-link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    margin-bottom: 20px;
    transition: color 0.18s ease;
  }
  .back-link:hover {
    color: var(--ink);
  }
  .analisi-detail__title {
    font-family: var(--serif);
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }
  .analisi-detail__intro {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .analisi-detail__updated {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-top: 16px;
  }

  @media (max-width: 640px) {
    .back-link { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
