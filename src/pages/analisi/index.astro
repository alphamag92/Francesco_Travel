---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/paths';
import { PAGES } from '~/data/site';

const { eyebrow, title, lede } = PAGES.analisi;
---

<BaseLayout title={title} description={lede}>
  <section class="page analisi-hub">
    <header class="analisi-hub__head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="analisi-hub__title">{title}</h1>
      <p class="analisi-hub__lede">{lede}</p>
    </header>

    <div class="analisi-grid">
      <a class="analisi-card" href={withBase('analisi/italia-cina')}>
        <p class="analisi-card__kicker">Dashboard interattiva</p>
        <h2 class="analisi-card__title">Voli Italia–Cina · prezzi &amp; stagionalità</h2>
        <p class="analisi-card__blurb">
          Prezzi minimi e massimi mese per mese, confronto diretto vs scalo, rotte per regione e
          punteggi delle compagnie. Esplora i dati in modo interattivo.
        </p>
        <span class="analisi-card__cta">Apri la dashboard →</span>
      </a>

      <div class="analisi-card analisi-card--soon" aria-disabled="true">
        <p class="analisi-card__kicker">In arrivo</p>
        <h2 class="analisi-card__title">Altre analisi in arrivo</h2>
        <p class="analisi-card__blurb">
          Nuovi approfondimenti su prezzi, stagionalità e strategie di prenotazione sono in
          preparazione.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .analisi-hub {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }
  .analisi-hub__head {
    max-width: 56ch;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .analisi-hub__title {
    font-family: var(--serif);
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 18px 0 20px;
  }
  .analisi-hub__lede {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .analisi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .analisi-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(24px, 3.5vw, 40px);
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--bg-soft);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  a.analisi-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  a.analisi-card:focus-visible {
    outline: 2px solid var(--terra);
    outline-offset: 3px;
  }

  .analisi-card__kicker {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }
  .analisi-card__title {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .analisi-card__blurb {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 52ch;
  }
  .analisi-card__cta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra);
    margin-top: 4px;
  }

  .analisi-card--soon {
    background: transparent;
    border-style: dashed;
    color: var(--ink-mute);
  }
  .analisi-card--soon .analisi-card__title,
  .analisi-card--soon .analisi-card__blurb {
    color: var(--ink-mute);
  }
</style>
