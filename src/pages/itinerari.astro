---
import { getImage } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ItineraryFilter from '~/components/react/ItineraryFilter';
import { getAllItineraries } from '~/data/itineraries';
import { CONTINENT_LABELS, durationBucket } from '~/lib/taxonomy';
import { withBase } from '~/lib/paths';
import { PAGES } from '~/data/site';
import '~/styles/cards.css';

// Optimize cover images server-side; the island only ever sees `coverSrc`
// strings (no astro:assets in the .tsx files).
const items = await Promise.all(
  getAllItineraries().map(async (it) => {
    const img = await getImage({ src: it.coverImage, width: 800, format: 'webp' });
    return {
      slug: it.slug,
      href: withBase(`itinerari/${it.slug}`),
      title: it.title,
      summary: it.summary,
      continent: it.continent,
      continentLabel: CONTINENT_LABELS[it.continent],
      durationDays: it.durationDays,
      durationLabel: `${it.durationDays} giorni`,
      durationBucket: durationBucket(it.durationDays),
      tags: it.tags,
      coverSrc: img.src,
      coverWidth: it.coverImage.width,
      coverHeight: it.coverImage.height,
      coverAlt: it.coverAlt,
    };
  }),
);

const { eyebrow, title, lede } = PAGES.itinerari;
---

<BaseLayout title={title} description={lede}>
  <section class="page itinerari">
    <header class="itinerari__head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="itinerari__title">{title}</h1>
      <p class="itinerari__lede">{lede}</p>
    </header>

    <ItineraryFilter client:load items={items} />
  </section>
</BaseLayout>

<style>
  .itinerari {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }
  .itinerari__head {
    max-width: 56ch;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .itinerari__title {
    font-family: var(--serif);
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 18px 0 20px;
  }
  .itinerari__lede {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }
</style>
