---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/paths';
---

<BaseLayout title="404 — Pagina non trovata" noindex={true}>
  <section class="page notfound">
    <p class="eyebrow">Errore 404</p>
    <h1 class="notfound__code serif">404</h1>
    <p class="notfound__msg">
      Pagina non trovata — forse il sentiero si è perso.
    </p>
    <div class="notfound__cta">
      <a class="btn" href={withBase('')}>Torna alla home</a>
      <a class="btn-ghost btn" href={withBase('itinerari')}>Vai agli itinerari</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-top: clamp(72px, 14vw, 180px);
    padding-bottom: clamp(96px, 16vw, 220px);
    text-align: center;
  }
  .notfound__code {
    font-size: clamp(96px, 26vw, 280px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: clamp(12px, 2vw, 20px) 0;
  }
  .notfound__msg {
    font-family: var(--serif);
    font-size: clamp(20px, 3vw, 30px);
    line-height: 1.3;
    color: var(--ink-soft);
    max-width: 24ch;
    margin: 0 auto;
  }
  .notfound__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: clamp(32px, 5vw, 52px);
  }
</style>
