---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/paths';
import { PAGES } from '~/data/site';

const { eyebrow, title, lede } = PAGES.chatbot;
---

<BaseLayout title="Assistente di viaggio" description={lede}>
  <section class="page chatbot">
    <header class="chatbot__head">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="chatbot__title serif">{title}</h1>
      <p class="chatbot__lede">{lede}</p>
    </header>

    <!-- Non-functional preview: visually muted, fully disabled. -->
    <div class="mock" aria-hidden="true">
      <div class="mock__thread">
        <div class="mock__bubble mock__bubble--bot">
          Ciao! A breve potrò aiutarti a costruire il tuo itinerario passo
          dopo passo.
        </div>
        <div class="mock__bubble mock__bubble--user">
          Vorrei due settimane tra città e natura…
        </div>
        <div class="mock__bubble mock__bubble--bot mock__bubble--typing">
          <span class="dot"></span><span class="dot"></span><span class="dot"
          ></span>
        </div>
      </div>

      <form class="mock__bar" onsubmit="return false;">
        <input
          class="mock__input"
          type="text"
          placeholder="Chiedimi un itinerario… (presto disponibile)"
          disabled
          aria-disabled="true"
          tabindex="-1"
        />
        <button class="btn" disabled aria-disabled="true" tabindex="-1">
          Invia
        </button>
      </form>
    </div>

    <p class="chatbot__note">
      <span class="chip mono">In arrivo</span>
      L'assistente non è ancora attivo. Nel frattempo trovi tutto negli
      <a href={withBase('itinerari')}>itinerari</a> e nelle
      <a href={withBase('analisi')}>analisi</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .chatbot {
    padding-top: clamp(48px, 8vw, 104px);
    padding-bottom: clamp(72px, 12vw, 160px);
  }
  .chatbot__head {
    max-width: 56ch;
    margin-bottom: clamp(32px, 5vw, 52px);
  }
  .chatbot__title {
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 16px 0 18px;
  }
  .chatbot__lede {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  /* ---------- disabled chat mockup ---------- */
  .mock {
    max-width: 620px;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg-soft);
    overflow: hidden;
    opacity: 0.72;
    filter: saturate(0.85);
    user-select: none;
  }
  .mock__thread {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 3vw, 28px);
  }
  .mock__bubble {
    max-width: 76%;
    padding: 12px 16px;
    border-radius: 14px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .mock__bubble--bot {
    align-self: flex-start;
    background: var(--bg);
    border: 1px solid var(--rule);
    border-bottom-left-radius: 4px;
  }
  .mock__bubble--user {
    align-self: flex-end;
    background: var(--jade-soft);
    border: 1px solid var(--rule-soft);
    border-bottom-right-radius: 4px;
    color: var(--ink);
  }
  .mock__bubble--typing {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }
  .mock__bubble--typing .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-mute);
    display: inline-block;
  }

  .mock__bar {
    display: flex;
    gap: 10px;
    padding: 14px clamp(16px, 2.5vw, 22px);
    border-top: 1px solid var(--rule);
    background: var(--bg);
  }
  .mock__input {
    flex: 1;
    font-family: var(--sans);
    font-size: 14.5px;
    color: var(--ink-mute);
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 12px 14px;
    cursor: not-allowed;
  }
  .mock__input::placeholder {
    color: var(--ink-mute);
  }

  .chatbot__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: clamp(24px, 3vw, 32px);
    font-size: 14.5px;
    color: var(--ink-mute);
    max-width: 56ch;
  }
  .chatbot__note a {
    color: var(--ink-soft);
    text-underline-offset: 3px;
  }
  .chatbot__note a:hover {
    color: var(--terra);
  }
  .chip {
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 5px 12px;
  }
</style>
