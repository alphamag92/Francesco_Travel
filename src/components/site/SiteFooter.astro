---
import { NAV, SITE, AUTHOR } from '~/data/site';
import { withBase } from '~/lib/paths';

const year = new Date().getFullYear();
const range = year > SITE.startYear ? `${SITE.startYear}–${year}` : `${SITE.startYear}`;
---
<footer class="site-footer">
  <div class="page inner">
    <div class="lead">
      <p class="mk serif-it">{SITE.name}</p>
      <p class="tag">{SITE.tagline}</p>
    </div>
    <nav class="fnav" aria-label="Navigazione footer">
      <ul>
        {NAV.filter((n) => !n.disabled).map((item) => (
          <li><a href={withBase(item.path)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="page meta">
    <span>© {range} {SITE.name}. Tutti i diritti riservati.</span>
    <span>{AUTHOR.name}</span>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    margin-top: clamp(64px, 10vw, 140px);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: start;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: 32px;
  }
  .mk { font-size: clamp(30px, 4vw, 48px); line-height: 1; letter-spacing: -0.02em; margin: 0; }
  .tag { margin-top: 12px; color: var(--ink-soft); max-width: 34ch; }
  .fnav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; text-align: right; }
  .fnav a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .fnav a:hover { color: var(--ink); }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  @media (max-width: 640px) {
    .inner { grid-template-columns: 1fr; gap: 28px; }
    .fnav ul { text-align: left; grid-auto-flow: column; grid-template-columns: repeat(2, auto); justify-content: start; gap: 10px 28px; }
    .meta { flex-direction: column; gap: 6px; }
    .fnav a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
